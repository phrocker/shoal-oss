{
  "schema": "shoal.router.grammar/v1",
  "target": {
    "kind": "action",
    "capability": "maintenance",
    "action": "drain_environment"
  },
  "cues": [
    "drain",
    "evacuate",
    "maintenance",
    "rotation"
  ],
  "patterns": [
    "[please] drain [the] {environment} [environment]",
    "evacuate {environment}",
    "drain everything in {environment}"
  ],
  "slots": [
    {
      "name": "environment",
      "node_kinds": [
        "environment"
      ]
    }
  ],
  "input": {
    "environment": "$environment"
  }
}
