{
  "schema": "shoal.router.grammar/v1",
  "target": {
    "kind": "action",
    "capability": "logs",
    "action": "tail_logs"
  },
  "cues": [
    "tail",
    "logs",
    "stream",
    "follow",
    "watch"
  ],
  "patterns": [
    "tail [the] {service} logs [in {environment}]",
    "tail logs for {service} [in {environment}]",
    "stream [the] {service} logs [in {environment}]",
    "follow [the] {service} logs [in {environment}]",
    "watch the logs of {service} [in {environment}]",
    "let me see {service} logs",
    "{service} logs in {environment} tail them"
  ],
  "slots": [
    {
      "name": "service",
      "node_kinds": [
        "service"
      ]
    },
    {
      "name": "environment",
      "node_kinds": [
        "environment"
      ]
    }
  ],
  "input": {
    "service": "$service",
    "environment": "$environment"
  }
}
