{
  "schema": "shoal.router.grammar/v1",
  "target": {
    "kind": "action",
    "capability": "oncall",
    "action": "page_team"
  },
  "cues": [
    "page",
    "alert",
    "oncall",
    "phone"
  ],
  "patterns": [
    "[please] page [the] {team} [now]",
    "get [the] {team} on the phone",
    "page [the] {team} about this"
  ],
  "slots": [
    {
      "name": "team",
      "node_kinds": [
        "team"
      ]
    }
  ],
  "input": {
    "team": "$team"
  }
}
